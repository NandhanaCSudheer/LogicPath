# LogicPath Backend Environment Variables Example
# Duplicate this file as .env and fill in your actual configuration

MONGO_URI=mongodb://127.0.0.1:27017/logicpath
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_production
JWT_EXPIRATION_HOURS=24
PORT=5000
DEBUG=True

# Optional External AI Verification Service
# Options: "gemini", "openai", "deterministic"
AI_PROVIDER=deterministic
AI_API_KEY=
